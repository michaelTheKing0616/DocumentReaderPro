# Supabase (hosted free tier or self-hosted — https://supabase.com)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Enable mock gaze/hardware streams in non-dev builds (default: dev only)
EXPO_PUBLIC_ENABLE_MOCK_DATA=false

# Enable cloud sync when Supabase is configured and user is signed in
EXPO_PUBLIC_SYNC_ENABLED=true

# Hugging Face quiz edge function (optional)
EXPO_PUBLIC_HF_QUIZ_EDGE_URL=https://your-project.supabase.co/functions/v1/hf-quiz

# Gaze360 dev dataset manifest (optional, dev-only)
EXPO_PUBLIC_GAZE360_MANIFEST_URL=

# Observability (optional)
EXPO_PUBLIC_SENTRY_DSN=https://your-key@o123.ingest.sentry.io/456
EXPO_PUBLIC_POSTHOG_KEY=phc_your_posthog_project_key
EXPO_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Stripe billing (optional — premium gates)
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_key
EXPO_PUBLIC_STRIPE_PRICE_ID=price_premium_monthly
EXPO_PUBLIC_MOCK_PREMIUM=false

# Cloud drive OAuth
EXPO_PUBLIC_GOOGLE_DRIVE_CLIENT_ID=your-google-client-id
EXPO_PUBLIC_GOOGLE_DRIVE_CLIENT_SECRET=your-google-client-secret
EXPO_PUBLIC_DROPBOX_CLIENT_ID=your-dropbox-client-id
EXPO_PUBLIC_DROPBOX_CLIENT_SECRET=your-dropbox-client-secret
EXPO_PUBLIC_ONEDRIVE_CLIENT_ID=your-onedrive-client-id
EXPO_PUBLIC_ONEDRIVE_CLIENT_SECRET=your-onedrive-client-secret

# Export integrations
EXPO_PUBLIC_EVERNOTE_CONSUMER_KEY=your-evernote-key
EXPO_PUBLIC_EVERNOTE_SHARD=sandbox
EXPO_PUBLIC_GOODREADS_API_KEY=your-goodreads-key

# Stripe edge functions (Supabase secrets — not client-side)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_ID=price_premium_monthly
