{
  "name": "readassist-pro",
  "version": "1.0.0",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit -p tsconfig.ci.json",
    "test:e2e": "detox test -c android.emu.debug",
    "test:e2e:ios": "detox test -c ios.sim.debug",
    "electron": "electron electron/main.js",
    "electron:dev": "concurrently \"expo start --web\" \"wait-on http://localhost:8081 && cross-env WEBPACK_DEV_SERVER_URL=http://localhost:8081 electron electron/main.js\"",
    "build:web": "expo export --platform web --output-dir web-build"
  },
